# =============================================================================
# AscendOS — root .env.example
# Copy to .env and fill in real values. Never commit .env to version control.
# Per-service provider env templates live in infra/data-plane/providers/.
# =============================================================================

# --- Supabase / Postgres (shared) ---
DATABASE_URL="postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- Redis (Upstash) ---
REDIS_URL="rediss://default:<password>@<host>:<port>"
REDIS_TLS="true"

# --- MongoDB (Atlas) ---
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE="ascendos"

# --- Qdrant ---
QDRANT_URL="https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333"
QDRANT_API_KEY="<qdrant-api-key>"
QDRANT_COLLECTION="self_improvement_docs"

# --- InfluxDB ---
INFLUX_URL="https://<region>.aws.cloud2.influxdata.com"
INFLUX_TOKEN="<influx-token>"
INFLUX_ORG="<influx-org>"
INFLUX_BUCKET="ascendos_events"

# --- NATS ---
NATS_URL="nats://localhost:4222"

# --- core-gateway ---
CORE_GATEWAY_JWT_SECRET="change-me-in-production"
CORE_GATEWAY_JWT_ISSUER=""
CORE_GATEWAY_JWT_AUDIENCE=""
# Comma-separated OAuth2 provider IDs (e.g. "google,github")
CORE_GATEWAY_OAUTH_PROVIDERS=""
PORT=8080

# --- chronos ---
CHRONOS_DATA_DIR="/data/chronos"
CHRONOS_PORT=8081

# --- metis ---
METIS_DATA_DIR="/data/metis"
METIS_PORT=8082

# --- praxis ---
PRAXIS_DATA_DIR="/data/praxis"
PRAXIS_PORT=8083

# --- aegis (Rust) ---
RUST_LOG="info"
AEGIS_PORT=8084

# --- orator (Rust) ---
ORATOR_PORT=8085

# --- neuro (Python) ---
NEURO_PORT=7860

# --- argentum (Python) ---
ARGENTUM_PORT=7861

# --- kairos (Python) ---
KAIROS_PORT=7862

# --- agent-orchestrator (Python / LangGraph) ---
ORCHESTRATOR_PORT=7863

# --- Anthropic (LLM) ---
ANTHROPIC_API_KEY="sk-ant-<key>"
# Hard daily cost cap in USD; set to 0 to disable
MAX_DAILY_USD="1.00"
# Fallback model when budget is exhausted
FALLBACK_MODEL="ollama/llama3.1:8b"

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="ascendos"
GRAFANA_CLOUD_API_KEY="<grafana-api-key>"
